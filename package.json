{
  "name": "adithyan-biolink",
  "version": "1.0.0",
  "description": "Adithyan's Full-Stack Production Biolink & Gen-Z Portfolio Hub",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/e2e_verify.js",
    "test:cloudflare": "node test/cloudflare_test.js",
    "test:all": "npm test && npm run test:cloudflare",
    "pages:dev": "wrangler pages dev .",
    "deploy:cloudflare": "wrangler pages deploy . --project-name=adithyan-biolink"
  },
  "keywords": [
    "portfolio",
    "biolink",
    "full-stack",
    "spotify",
    "github",
    "express"
  ],
  "author": "Adithyan",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
